  "sop_markdown": "# Update a CRM lead\n\nUpdate the requested lead's lifecycle status and owner without changing unrelated fields. Stage changes and stop before the final persistent action.\n",
  "skill_markdown": "---\ndescription: Update a lead's lifecycle status and owner in a desktop CRM, with review before the final save.\n---\n\n# Update CRM lead\n\nLocate the exact lead, change only the requested fields, stage the result, and wait for approval before committing.\n",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["lead_name", "lifecycle_status", "owner_name"],
    "properties": {
      "lead_name": {"type": "string", "minLength": 1},
      "lifecycle_status": {"type": "string", "minLength": 1},
      "owner_name": {"type": "string", "minLength": 1}
    }
  },
  "tools_code": "def normalize_lead_update(payload):\n    return {key: ' '.join(str(value).split()) for key, value in payload.items()}\n",
